PORT=3001
CORS_ORIGIN=http://app.forum.test,http://localhost:3000,http://127.0.0.1:3000

# Linux: direct container-to-container — host.docker.internal is not available by default
# Windows/Mac: replace with host.docker.internal and port 54321 (Docker Desktop resolves it)
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=

# Linux: direct container-to-container (container name resolves on the shared Docker network)
# DB_HOST=supabase_db_forum-api DB_PORT=5432
# For migrations, change back to DB_HOST=127.0.0.1 DB_PORT=54322

# Windows/Mac: use DB_HOST=host.docker.internal DB_PORT=54322 instead
DB_HOST=host.docker.internal
DB_PORT=54322
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

